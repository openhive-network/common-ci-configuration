ARG PYTHON_RUNTIME_VERSION
FROM registry.gitlab.syncad.com/hive/common-ci-configuration/python_runtime:${PYTHON_RUNTIME_VERSION} AS python-scripts

COPY scripts/python/*.py /
COPY scripts/python/requirements.txt /
RUN pip install -r requirements.txt
# The chiseled base enters through pebble; CI runs the job shell directly
ENTRYPOINT []
CMD [ "bash" ]
