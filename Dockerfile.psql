# syntax=docker/dockerfile:1.5
# psql base image version: 14-2 (with SIGTERM handling in run_with_reconnect.sh)
#
# NOTE on CI rebuild triggers: this image COPYs scripts from haf-app-tools/scripts/.
# build_psql_image's rules in .gitlab-ci.yml must list those paths alongside
# Dockerfile.psql, or wrapper-only changes won't trigger a rebuild.
ARG PAAS_PSQL_VERSION=11251948d5dd4867552f9b9836a9e02110304df5
FROM ghcr.io/alphagov/paas/psql:${PAAS_PSQL_VERSION} AS psql

RUN <<EOF
    set -e
    apk add --no-cache sudo git bash python3 py3-psycopg2
    adduser -s /bin/bash -G users -D "haf_admin"
    echo "haf_admin ALL=(ALL:ALL) NOPASSWD:ALL" >> /etc/sudoers
EOF

COPY haf-app-tools/scripts/run_with_reconnect.sh /usr/local/bin/run_with_reconnect.sh
COPY haf-app-tools/scripts/install_with_app_lock.py /usr/local/bin/install_with_app_lock.py

USER haf_admin
WORKDIR /home/haf_admin

ENTRYPOINT [ "psql" ]