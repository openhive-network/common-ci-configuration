# syntax=docker/dockerfile:1.5
# psql base image version: 14-4 (scripts in /usr/local/bin installed 0755)
#
# NOTE on CI rebuild triggers: this image COPYs scripts from haf-app-tools/scripts/.
# build_psql_image's rules in .gitlab-ci.yml must list those paths alongside
# Dockerfile.psql, or wrapper-only changes won't trigger a rebuild.
ARG PAAS_PSQL_VERSION
FROM ghcr.io/alphagov/paas/psql:${PAAS_PSQL_VERSION} AS psql

RUN <<EOF
    set -e
    apk add --no-cache sudo git bash python3 py3-psycopg2
    adduser -s /bin/bash -G users -D "haf_admin"
    echo "haf_admin ALL=(ALL:ALL) NOPASSWD:ALL" >> /etc/sudoers
EOF

# --chmod: plain COPY keeps the build context's modes, and a checkout made under
# umask 0000 (the GitLab Docker-executor default) leaves these 0777, writable by
# the non-root runtime user of every app image built on this one.
COPY --chmod=0755 haf-app-tools/scripts/run_with_reconnect.sh /usr/local/bin/run_with_reconnect.sh
COPY --chmod=0755 haf-app-tools/scripts/install_with_app_lock.py /usr/local/bin/install_with_app_lock.py
COPY --chmod=0755 haf-app-tools/scripts/haf_app_driver.py /usr/local/bin/haf_app_driver.py

RUN <<EOF
    set -e
    writable="$(find /usr/local/bin -perm /022 -type f)"
    if [ -n "$writable" ]; then
        echo "group- or other-writable files in /usr/local/bin:" >&2
        echo "$writable" >&2
        exit 1
    fi
EOF

USER haf_admin
WORKDIR /home/haf_admin

ENTRYPOINT [ "psql" ]