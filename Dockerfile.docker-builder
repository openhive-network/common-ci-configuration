# syntax=docker/dockerfile:1.4
# Docker CLI image for jobs that drive a DinD service. Built on python-test-tools
# (Ubuntu 26.04, Python 3.14, every test/lint tool at the docker-bake.hcl
# versions), so HAF-app e2e jobs that need Docker run the same tools as the
# rest of CI. docker-bake.hcl builds the base from this checkout.
ARG PYTHON_TEST_TOOLS_TAG
ARG DOCKER_VERSION
FROM registry.gitlab.syncad.com/hive/common-ci-configuration/mirrors/docker-${DOCKER_VERSION}-cli AS docker-cli

FROM registry.gitlab.syncad.com/hive/common-ci-configuration/python-test-tools:${PYTHON_TEST_TOOLS_TAG} AS docker-builder
ARG DOCKER_VERSION
ARG DOCKER_COMPOSE_VERSION
ARG DOCKER_BUILDX_VERSION

# Disable buildx attestations (provenance/SBOM) to avoid panic in buildkit
# when parsing empty digests. Can be removed when buildkit bug is fixed.
# See: https://github.com/moby/buildkit/issues/4778
ENV BUILDX_NO_DEFAULT_ATTESTATIONS=1
# Read by docker-entrypoint.sh, which points DOCKER_HOST at the `docker` DinD
# service (with TLS when its client certs are mounted)
ENV DOCKER_TLS_CERTDIR=/certs

# xstream (used by JMeter's m2u converter) needs reflective access to JDK
# internals, which Java >= 16 denies by default
ENV JAVA_TOOL_OPTIONS="--add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.text=ALL-UNNAMED --add-opens=java.desktop/java.awt.font=ALL-UNNAMED"

# Static docker CLI, buildx and compose plus the entrypoint of the official image
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker-entrypoint.sh /usr/local/bin/
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins

# Copy JMeter and m2u from benchmark-test-runner (pre-built)
COPY --from=registry.gitlab.syncad.com/hive/common-ci-configuration/benchmark-test-runner:latest \
    /opt/tools/jmeter /opt/tools/jmeter
COPY --from=registry.gitlab.syncad.com/hive/common-ci-configuration/benchmark-test-runner:latest \
    /opt/tools/m2u /opt/tools/m2u

# util-linux (flock on NFS) is part of the Ubuntu base; the JRE runs JMeter
RUN <<EOF
    set -e
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        openjdk-21-jre-headless sudo
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    ln -s /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose
    ln -s /opt/tools/jmeter/bin/jmeter.sh /usr/bin/jmeter
    ln -s /opt/tools/m2u/m2u /usr/bin/m2u

    docker --version
    docker compose version
    docker buildx version
    test "$(docker --version | cut -d' ' -f3)" = "${DOCKER_VERSION},"
    test "$(docker compose version --short)" = "${DOCKER_COMPOSE_VERSION#v}"
    test "$(docker buildx version | cut -d' ' -f2)" = "${DOCKER_BUILDX_VERSION}"
EOF

# hived (UID 1000, owner of the tools venv) comes from python-test-tools
USER hived
WORKDIR /home/hived

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["/bin/bash"]
