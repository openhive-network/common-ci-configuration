# CI Base Image (Ubuntu) for HAF development and testing
# Ubuntu-based variant needed because HAF builds hived on Ubuntu
# and replay/test jobs must run those binaries directly.
#
# The manylinux-based ci-base-image (AlmaLinux 8, glibc 2.28) cannot run
# Ubuntu-built binaries due to glibc version mismatch.
#
# Ubuntu 26.04 ships Python 3.14 as the system python3 and LLVM 21 as the
# distro toolchain, so no deadsnakes PPA or apt.llvm.org repo is needed.
#
# The build/test environment (packages, the hived account, Docker CLI,
# websocat, faketime, Poetry) is installed by scripts/bash/setup_ubuntu.sh, a
# copy of hive's scripts/setup_ubuntu.sh. Only the HAF-specific layers
# (PostgreSQL, libpqxx, sccache) are written out here.
#
# Build:
#   docker build -f Dockerfile.ci-base-image-ubuntu -t ci-base-image-ubuntu:ubuntu26.04-pg18-3 .

ARG BASE_IMAGE=phusion/baseimage:resolute-1.0.11
FROM ${BASE_IMAGE}

ARG DOCKER_CLI_VERSION=28.0.1
ARG PG_MAJOR=18

ENV LANG=en_US.UTF-8
ENV PATH="/home/hived/.local/bin:$PATH"

SHELL ["/bin/bash", "-c"]

USER root
WORKDIR /usr/local/src

COPY scripts/bash/setup_ubuntu.sh scripts/bash/openssl.conf /usr/local/src/scripts/

# Install runtime and development packages (LLVM/Clang, Python 3.14, build tools, libraries)
RUN ./scripts/setup_ubuntu.sh --runtime --dev

# Install PostgreSQL ${PG_MAJOR} development packages from PGDG
RUN apt-get update && \
    apt-get install -y gnupg lsb-release && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y \
        postgresql-server-dev-${PG_MAJOR} \
        libpq-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install libpqxx 7.10.7 (PostgreSQL C++ connector; 7.8.x does not configure
# with CMake >= 3.31 as shipped on 26.04)
RUN git clone --depth 1 --branch 7.10.7 https://github.com/jtv/libpqxx.git /tmp/libpqxx && \
    cd /tmp/libpqxx && \
    mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release -GNinja -DBUILD_TEST=OFF .. && \
    ninja install && \
    cd / && rm -rf /tmp/libpqxx

# Install sccache for distributed compiler caching
RUN curl -fsSL https://github.com/mozilla/sccache/releases/download/v0.8.1/sccache-v0.8.1-x86_64-unknown-linux-musl.tar.gz \
    | tar xz -C /usr/local/bin --strip-components=1 --wildcards '*/sccache' \
    && chmod +x /usr/local/bin/sccache

# Remove default ubuntu user (UID 1000) from phusion/baseimage to free UID 1000 for hived
RUN userdel --remove ubuntu 2>/dev/null || true

# Create the hived account (UID 1000, NOPASSWD sudo) and install Docker CLI + buildx
RUN ./scripts/setup_ubuntu.sh --hived-account=hived --docker-cli=${DOCKER_CLI_VERSION}

USER hived
WORKDIR /home/hived

# Install faketime and websocat, configure git safe.directory and install Poetry.
# The directory --user builds in is removed: images built on top of this one
# (e.g. HAF's ci-base-image) run --user again, which clones faketime into it.
RUN /usr/local/src/scripts/setup_ubuntu.sh --user && rm -rf /home/hived/hive_base_config

# Compile Python bytecode for faster startup
RUN python3 -c "import sysconfig, compileall; compileall.compile_dir(sysconfig.get_path('stdlib'))"
