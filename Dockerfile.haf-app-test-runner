# syntax=docker/dockerfile:1.4
# Shared test runner for HAF applications (balance_tracker, reputation_tracker, haf_block_explorer)
# Provides: Python 3.14, Poetry, Docker CLI, JMeter, PostgreSQL client
#
# Based on ci-base-image-ubuntu (Ubuntu 26.04, native Python 3.14).
# Use with docker-dind service for Docker-in-Docker testing.

ARG CI_BASE_IMAGE_VERSION=ubuntu26.04-pg18-1
FROM registry.gitlab.syncad.com/hive/common-ci-configuration/ci-base-image-ubuntu:${CI_BASE_IMAGE_VERSION}

# Copy JMeter and m2u from benchmark-test-runner
COPY --from=registry.gitlab.syncad.com/hive/common-ci-configuration/benchmark-test-runner:latest \
  /opt/tools/jmeter /opt/tools/jmeter
COPY --from=registry.gitlab.syncad.com/hive/common-ci-configuration/benchmark-test-runner:latest \
  /opt/tools/m2u /opt/tools/m2u

USER root
RUN <<EOF
  set -e

  # Install additional dependencies
  apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jre-headless \
    postgresql-client \
    docker-compose-v2 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

  # Create symlinks for JMeter and m2u
  ln -s /opt/tools/jmeter/bin/jmeter.sh /usr/bin/jmeter
  ln -s /opt/tools/m2u/m2u /usr/bin/m2u

  # Install Python packages needed by HAF app tests
  pip3 install --no-cache-dir --break-system-packages psycopg2-binary

  # Ensure hived user exists with UID 1000 (matching HAF container conventions).
  # The base image should have hived at UID 1000, but if not, create it.
  # Without explicit -u 1000, useradd picks next available UID (e.g. 2001),
  # causing tar-extracted files to have wrong ownership inside HAF containers.
  if ! id hived 2>/dev/null; then
    userdel --remove ubuntu 2>/dev/null || true
    useradd -ms /bin/bash -u 1000 -g users hived
  fi
  echo "hived ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
EOF

USER hived
CMD ["/bin/bash"]
