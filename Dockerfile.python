# DEPRECATED: kept only for hivesense (submodules/hivemind). All other
# consumers use ci-base-image (Python 3.14). Retire once hivesense migrates.
ARG PYTHON_VERSION=3.14.2-slim-bookworm
FROM python:${PYTHON_VERSION}

# renovate: datasource=pypi depName=poetry versioning=semver
ARG POETRY_VERSION=2.1.3

# Install poetry and git (commonly needed for installing packages from git repos)
RUN pip install --no-cache-dir poetry==${POETRY_VERSION} && \
    apt-get update && \
    apt-get install -y --no-install-recommends git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*