# CI Base Image for Python development and testing
# Based on manylinux_2_28 (AlmaLinux 8) with multiple Python versions pre-installed
# Provides full build toolchain for C++ projects (hived, HAF), building Python wheels and Python testing
#
# This replaces the ci-base-image previously built from hive/hive repo
#
# Python version can be selected at runtime via PYTHON_VERSION environment variable:
#   docker run -e PYTHON_VERSION=3.14 ci-base-image:pypa_2_28-2 python3 --version
#
# Default Python version is 3.14
# In future you might want to change pypa image tag to get newer Python versions as they are added

ARG BASE_IMAGE=quay.io/pypa/manylinux_2_28:2026.01.16-1

# --- Preinstall vendor libraries for hive ---
# RocksDB build stage: produces a static library + CMake package config + sst_dump tool
# installed under /opt/hive/vendor/rocksdb/<commit-hash>/ for commit-hash-indexed detection.
# When hive's CMake detects a preinstalled build matching its submodule commit, it skips the
# ~2000-file RocksDB compilation entirely.
FROM ${BASE_IMAGE} AS rocksdb-builder

# Commit hash of the rocksdb submodule used in hive.
# Override via: docker build --build-arg ROCKSDB_COMMIT=<hash> ...
ARG ROCKSDB_COMMIT=ae8fb3e5000e46d8d4c9dbf3a36019c0aaceebff
ARG ROCKSDB_INSTALL_PREFIX=/opt/hive/vendor/rocksdb/${ROCKSDB_COMMIT}

# CMake version must match the main stage to ensure consistent behavior
ARG CMAKE_VERSION=3.28.6

SHELL ["/bin/bash", "-c"]

# Install build dependencies (AlmaLinux 8 / manylinux_2_28)
RUN dnf install -y \
        git \
        gcc-c++ \
        ninja-build \
        liburing-devel \
    && dnf clean all && rm -rf /var/cache/dnf

# Install CMake (same version as main stage)
RUN curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
    | tar xz -C /usr/local --strip-components=1

# Build and install snappy static library (same as main stage — repos lack snappy-static)
ARG SNAPPY_VERSION=1.1.10
RUN set -e && \
    curl -fsSL "https://github.com/google/snappy/archive/refs/tags/${SNAPPY_VERSION}.tar.gz" \
        | tar xz -C /tmp && \
    cd /tmp/snappy-${SNAPPY_VERSION} && \
    mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DBUILD_SHARED_LIBS=OFF \
        -DSNAPPY_BUILD_TESTS=OFF \
        -DSNAPPY_BUILD_BENCHMARKS=OFF && \
    make -j "$(nproc)" && \
    make install && \
    cd / && rm -rf /tmp/snappy-${SNAPPY_VERSION}

WORKDIR /tmp/rocksdb-build

# Clone at specific commit (shallow, reliable method for arbitrary commit hashes)
RUN git init src && cd src && \
    git fetch --depth 1 https://github.com/facebook/rocksdb.git ${ROCKSDB_COMMIT} && \
    git checkout FETCH_HEAD

# Build with EXACT same options as hive/libraries/vendor/CMakeLists.txt.
# CRITICAL: These flags must stay in sync with hive's vendor/CMakeLists.txt.
# If hive changes its RocksDB build options, update these flags accordingly.
RUN cmake -GNinja -S src -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=${ROCKSDB_INSTALL_PREFIX} \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DBUILD_SHARED_LIBS=OFF \
    -DROCKSDB_BUILD_SHARED=OFF \
    -DFAIL_ON_WARNINGS=OFF \
    -DWITH_TESTS=OFF \
    -DWITH_SNAPPY=ON \
    -DWITH_ZLIB=OFF \
    -DWITH_BZ2=OFF \
    -DWITH_LIBURING=ON \
    -DWITH_BENCHMARK_TOOLS=OFF \
    -DWITH_CORE_TOOLS=ON \
    -DWITH_TOOLS=OFF \
    -DWITH_TRACE_TOOLS=OFF \
    -DWITH_GFLAGS=OFF \
    -DUSE_RTTI=ON \
    -DPORTABLE=ON && \
    ninja -C build -j$(nproc) && \
    cmake --install build

# Copy sst_dump tool to bin/ directory for use by hive's build.sh
RUN if [ -f build/tools/sst_dump ]; then \
      mkdir -p ${ROCKSDB_INSTALL_PREFIX}/bin && \
      cp build/tools/sst_dump ${ROCKSDB_INSTALL_PREFIX}/bin/; \
    else \
      echo "WARNING: sst_dump not found in build/tools/"; \
    fi

# Clean up build artifacts (only the installed prefix is needed)
RUN rm -rf /tmp/rocksdb-build

# --- Main ci-base-image stage ---
FROM ${BASE_IMAGE}

ARG POETRY_VERSION=2.1.3
ARG DOCKER_CLI_VERSION=28.0.1
ARG BUILDX_VERSION=v0.24.0

ENV DEFAULT_PYTHON_VERSION=3.14
ENV PYTHON_VERSION=${DEFAULT_PYTHON_VERSION}
ENV LANG=en_US.UTF-8
ENV PATH="/home/hived_admin/.local/bin:$PATH"

SHELL ["/bin/bash", "-c"]

USER root
WORKDIR /usr/local/src

# Install runtime and development packages
# manylinux_2_28 is based on AlmaLinux 8, uses dnf/yum
# Enable PowerTools and add devel repo for static libraries and development packages
RUN dnf install -y epel-release && \
    dnf config-manager --set-enabled powertools && \
    dnf config-manager --add-repo https://repo.almalinux.org/almalinux/8/devel/x86_64/os/ && \
    dnf install -y \
        # Runtime packages
        langpacks-en \
        sudo \
        screen \
        snappy \
        readline \
        wget \
        curl \
        ca-certificates \
        # Build tools
        git \
        autoconf \
        automake \
        gcc-c++ \
        clang \
        clang-tools-extra \
        libtool \
        make \
        pkgconfig \
        ninja-build \
        flex \
        bison \
        vim-common \
        # Libraries (shared and development)
        bzip2-devel \
        libpq-devel \
        snappy-devel \
        ncurses-devel \
        readline-devel \
        liburing-devel \
        libicu-devel \
        zlib-devel \
        # Static libraries from devel repo
        bzip2-static \
        ncurses-static \
        readline-static \
        zlib-static \
        # Misc
        parallel \
        perl \
        p7zip \
        p7zip-plugins \
        tzdata \
        glib2 \
        glib2-devel \
        gobject-introspection \
        libxml2 \
        shared-mime-info \
        xdg-user-dirs \
    && dnf clean all && rm -rf /var/cache/dnf

# Install PostgreSQL 18 development packages from PGDG repo
# Required for building PostgreSQL extensions (HAF fork manager, sql_serializer)
# Provides pg_config, server headers, and libpq at /usr/pgsql-18/
RUN dnf install -y --nogpgcheck \
        https://download.postgresql.org/pub/repos/yum/reporpms/EL-8-x86_64/pgdg-redhat-repo-latest.noarch.rpm && \
    dnf module disable -y postgresql && \
    dnf install -y --nogpgcheck \
        postgresql18-devel \
    && dnf clean all && rm -rf /var/cache/dnf

# Add PostgreSQL 18 bin directory to PATH (for pg_config)
ENV PATH="/usr/pgsql-18/bin:$PATH"

# Fix PAM configuration for sudo (manylinux has minimal PAM setup)
COPY <<'EOF' /etc/pam.d/sudo
auth       sufficient   pam_rootok.so
auth       sufficient   pam_unix.so
account    sufficient   pam_unix.so
account    sufficient   pam_permit.so
session    optional     pam_unix.so
EOF

# Install CMake 3.28.6 (pinned version for build reproducibility)
# Note: CMake 3.31.x has compatibility issues with libpqxx 7.8.1
ARG CMAKE_VERSION=3.28.6
RUN curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
    | tar xz -C /usr/local --strip-components=1

# Build and install Doxygen from source (pre-built binaries require glibc 2.29+)
# AlmaLinux 8 only has 1.8.14 in repos, hive requires 1.9.x for wallet help generation
ARG DOXYGEN_VERSION=1.9.8
RUN set -e && \
    curl -fsSL "https://github.com/doxygen/doxygen/archive/refs/tags/Release_${DOXYGEN_VERSION//./_}.tar.gz" \
        | tar xz -C /tmp && \
    cd /tmp/doxygen-Release_${DOXYGEN_VERSION//./_} && \
    mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local && \
    make -j "$(nproc)" && \
    make install && \
    cd / && rm -rf /tmp/doxygen-Release_${DOXYGEN_VERSION//./_} && \
    doxygen --version

# Build and install snappy with static library (snappy-static not available in repos)
ARG SNAPPY_VERSION=1.1.10
RUN set -e && \
    curl -fsSL "https://github.com/google/snappy/archive/refs/tags/${SNAPPY_VERSION}.tar.gz" \
        | tar xz -C /tmp && \
    cd /tmp/snappy-${SNAPPY_VERSION} && \
    mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DBUILD_SHARED_LIBS=OFF \
        -DSNAPPY_BUILD_TESTS=OFF \
        -DSNAPPY_BUILD_BENCHMARKS=OFF && \
    make -j "$(nproc)" && \
    make install && \
    cd / && rm -rf /tmp/snappy-${SNAPPY_VERSION}

# Build and install OpenSSL 3.0.13 with both static and shared libraries
# Version matches Ubuntu 24.04's OpenSSL for compatibility
# Built with -fPIC for position-independent code (required for Python extensions)
ARG OPENSSL_VERSION=3.0.13
RUN set -e && \
    curl -fsSL "https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz" \
        | tar xz -C /tmp && \
    cd /tmp/openssl-${OPENSSL_VERSION} && \
    ./config \
        --prefix=/usr/local \
        --openssldir=/usr/local/ssl \
        --libdir=lib \
        shared \
        -fPIC && \
    make -j "$(nproc)" && \
    make install && \
    cd / && rm -rf /tmp/openssl-${OPENSSL_VERSION} && \
    # Add /usr/local/lib to library search path and update cache
    echo "/usr/local/lib" > /etc/ld.so.conf.d/openssl.conf && \
    ldconfig && \
    # Verify installation
    test -f /usr/local/include/openssl/ssl.h && \
    test -f /usr/local/lib/libssl.a && \
    test -f /usr/local/lib/libcrypto.a

# Set OpenSSL paths for CMake - used by projects to force static linking
# These env vars are read by CMakeLists.txt and set as cache variables
ENV OPENSSL_ROOT_DIR=/usr/local
ENV OPENSSL_INCLUDE_DIR=/usr/local/include
ENV OPENSSL_CRYPTO_LIBRARY=/usr/local/lib/libcrypto.a
ENV OPENSSL_SSL_LIBRARY=/usr/local/lib/libssl.a

# Build and install Boost 1.83.0 (AlmaLinux 8 only has 1.66, hive requires >= 1.74)
ARG BOOST_VERSION=1.83.0
RUN set -e && \
    BOOST_VERSION_UNDERSCORE=$(echo ${BOOST_VERSION} | tr '.' '_') && \
    curl -fsSL "https://archives.boost.io/release/${BOOST_VERSION}/source/boost_${BOOST_VERSION_UNDERSCORE}.tar.gz" \
        | tar xz -C /tmp && \
    cd /tmp/boost_${BOOST_VERSION_UNDERSCORE} && \
    ./bootstrap.sh --prefix=/usr/local && \
    ./b2 \
        -j "$(nproc)" \
        -q \
        cxxflags=-fPIC \
        runtime-link=shared \
        link=static \
        threading=multi \
        --with-atomic \
        --with-chrono \
        --with-context \
        --with-coroutine \
        --with-date_time \
        --with-filesystem \
        --with-iostreams \
        --with-locale \
        --with-program_options \
        --with-regex \
        --with-system \
        --with-thread \
        --with-test \
        install && \
    cd / && rm -rf /tmp/boost_${BOOST_VERSION_UNDERSCORE}

# Install libpqxx 7.8.1 (PostgreSQL C++ connector)
# Required by HAF for C++ database connectivity
RUN git clone --depth 1 --branch 7.8.1 https://github.com/jtv/libpqxx.git /tmp/libpqxx && \
    cd /tmp/libpqxx && \
    mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release -GNinja -DBUILD_TEST=OFF .. && \
    ninja install && \
    cd / && rm -rf /tmp/libpqxx

# Copy preinstalled RocksDB from the builder stage
# Provides /opt/hive/vendor/rocksdb/<commit>/{lib,include,bin} with:
# - librocksdb.a (static library)
# - CMake package config (RocksDBConfig.cmake, RocksDBTargets.cmake)
# - sst_dump tool (in bin/)
COPY --from=rocksdb-builder /opt/hive/vendor /opt/hive/vendor

# Install sccache for distributed compiler caching
RUN curl -fsSL https://github.com/mozilla/sccache/releases/download/v0.8.1/sccache-v0.8.1-x86_64-unknown-linux-musl.tar.gz \
    | tar xz -C /usr/local/bin --strip-components=1 --wildcards '*/sccache' \
    && chmod +x /usr/local/bin/sccache

# Set sccache cache directory (defaults to /.cache which isn't writable)
ENV SCCACHE_DIR=/tmp/sccache

# Create hived_admin user with sudo access (for backwards compatibility with hive/hive ci-base-image)
RUN useradd -ms /bin/bash -u 2000 -g users -c "Hived admin account" hived_admin && \
    echo "hived_admin ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Create hived user for running hived daemon (used by hive builds)
# chmod 710 allows group (users) to traverse /home/hived so hived_admin can access /home/hived/bin
RUN useradd -ms /bin/bash -u 2001 -g users -c "Hived daemon account" hived && \
    chmod 710 /home/hived

# Install Docker CLI
RUN curl -fsSLO "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" && \
    tar xzvf "docker-${DOCKER_CLI_VERSION}.tgz" --strip 1 -C /usr/local/bin docker/docker && \
    rm "docker-${DOCKER_CLI_VERSION}.tgz" && \
    mkdir -p /usr/libexec/docker/cli-plugins && \
    curl -fsSL "https://github.com/docker/buildx/releases/download/${BUILDX_VERSION}/buildx-${BUILDX_VERSION}.linux-amd64" \
        -o /usr/libexec/docker/cli-plugins/docker-buildx && \
    chmod +x /usr/libexec/docker/cli-plugins/docker-buildx

# Install websocat
RUN wget -q https://github.com/vi/websocat/releases/download/v1.11.0/websocat.x86_64-unknown-linux-musl \
        -O /usr/local/bin/websocat && \
    chmod +x /usr/local/bin/websocat

# Install zopfli (Google compression tool, used by hive build)
ARG ZOPFLI_VERSION=zopfli-1.0.3
RUN git clone --depth 1 --branch ${ZOPFLI_VERSION} https://github.com/google/zopfli.git /tmp/zopfli && \
    cd /tmp/zopfli && \
    make -j "$(nproc)" zopfli && \
    cp zopfli /usr/local/bin/ && \
    ln -sf /usr/local/bin/zopfli /usr/bin/zopfli && \
    cd / && rm -rf /tmp/zopfli

# Install faketime (Syncad fork with bw_timer_settime_fix)
RUN git clone --depth 1 --branch bw_timer_settime_fix https://gitlab.syncad.com/hive/faketime.git /tmp/faketime && \
    cd /tmp/faketime && \
    CFLAGS="-O2 -DFAKE_STATELESS=1" make && \
    make install && \
    cd / && rm -rf /tmp/faketime

# Install jinja2 system-wide for all Python versions (used by hive build scripts)
RUN for pydir in /opt/python/cp3*/bin; do \
        "$pydir/pip3" install jinja2; \
    done

# Create Python wrapper script that respects PYTHON_VERSION env var
# Supports: 3.9, 3.10, 3.11, 3.12, 3.13, 3.14, 3.14t (free-threaded)
# Works as python3, pip3, or select-python (outputs path) based on $0
COPY <<'EOF' /usr/local/bin/select-python
#!/bin/bash
set -e
VERSION=${PYTHON_VERSION:-3.14}
# Map version to cpython directory: 3.14 -> cp314-cp314, 3.14t -> cp314t-cp314t
PYDIR="/opt/python/cp${VERSION//./}-cp${VERSION//./}/bin"
[[ -d "$PYDIR" ]] || { echo "Python $VERSION not found (expected $PYDIR)" >&2; exit 1; }
case "${0##*/}" in
    python3|python) exec "$PYDIR/python3" "$@" ;;
    pip3|pip) exec "$PYDIR/pip3" "$@" ;;
    *) echo "$PYDIR" ;;
esac
EOF
RUN chmod +x /usr/local/bin/select-python && \
    ln -sf select-python /usr/local/bin/python3 && \
    ln -sf select-python /usr/local/bin/pip3

# Create symlinks for python and pip commands
RUN ln -sf /usr/local/bin/python3 /usr/local/bin/python && \
    ln -sf /usr/local/bin/pip3 /usr/local/bin/pip

# Compile Python bytecode for faster startup (default Python only)
RUN /usr/local/bin/python3 -c "import sysconfig, compileall; compileall.compile_dir(sysconfig.get_path('stdlib'), quiet=1)"

USER hived_admin
WORKDIR /home/hived_admin

# Configure git
RUN git config --global --add safe.directory '*'

# Install Poetry using default Python (3.14)
# Note: Poetry is installed once and uses the Python it was installed with,
# regardless of PYTHON_VERSION setting. This is intentional - Poetry manages
# virtualenvs and doesn't need to match the project's Python version.
RUN curl -sSL https://install.python-poetry.org | python3 - --version ${POETRY_VERSION}

# Add user local bin to PATH (poetry, pip install --user, etc.)
# Remove unversioned .so symlinks for ncurses/readline to force static linking
# Keep versioned .so.X files so bash and other tools still work at runtime
# The linker looks for .so files, so removing just the symlinks forces static linking
USER root
RUN rm -f /usr/lib64/libncurses.so /usr/lib64/libtinfo.so \
         /usr/lib64/libreadline.so /usr/lib64/libhistory.so \
         /lib64/libncurses.so /lib64/libtinfo.so \
         /lib64/libreadline.so /lib64/libhistory.so 2>/dev/null || true
USER hived_admin
