# Wheel Builder Image
# Based on ci-base-image with pyenv for flexible Python version management
#
# Build with specific Python major.minor version (latest patch is auto-detected):
#   docker buildx bake wheel-builder --set wheel-builder.args.PYENV_PYTHON_VERSION=3.13
#
# Version format: <python-major.minor>-<revision>
#
# NOTE: The glibc version (and thus wheel compatibility tag like manylinux_2_39)
# is determined by the base image. Ubuntu 24.04 ships with glibc 2.39.
# To target a different glibc version, change CI_BASE_IMAGE_VERSION to use
# a different Ubuntu version (e.g., ubuntu:22.04 for glibc 2.35).

ARG CI_BASE_IMAGE_VERSION=ubuntu24.04-py3.14-2
ARG CI_REGISTRY_IMAGE=registry.gitlab.syncad.com/hive/common-ci-configuration
FROM ${CI_REGISTRY_IMAGE}/ci-base-image:${CI_BASE_IMAGE_VERSION}

# Python major.minor version - latest patch will be auto-detected
ARG PYENV_PYTHON_VERSION=3.12

ENV PYENV_ROOT="/home/hived_admin/.pyenv"
ENV PATH="${PYENV_ROOT}/shims:${PYENV_ROOT}/bin:${PATH}"

USER root

# Install pyenv dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libbz2-dev \
        libffi-dev \
        liblzma-dev \
        libncursesw5-dev \
        libreadline-dev \
        libsqlite3-dev \
        libxml2-dev \
        libxmlsec1-dev \
        tk-dev \
        xz-utils \
        zlib1g-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

USER hived_admin
WORKDIR /home/hived_admin

# Install pyenv
RUN curl https://pyenv.run | bash

# Find latest patch version for the specified major.minor and install it
RUN set -ex && \
    # Update pyenv to get latest available versions
    cd "${PYENV_ROOT}" && git pull && \
    # Find the latest patch version for the given major.minor
    LATEST_PATCH=$(pyenv install --list | tr -d ' ' | grep -E "^${PYENV_PYTHON_VERSION}\.[0-9]+$" | tail -1) && \
    echo "Installing Python ${LATEST_PATCH} (latest patch for ${PYENV_PYTHON_VERSION})" && \
    pyenv install "${LATEST_PATCH}" && \
    pyenv global "${LATEST_PATCH}" && \
    pyenv rehash && \
    # Store the installed version for reference
    echo "${LATEST_PATCH}" > /home/hived_admin/.python-version-full

# Upgrade pip and install wheel building tools
RUN pip install --upgrade pip setuptools wheel build

# Install poetry for the pyenv Python
ARG POETRY_VERSION=2.1.3
RUN pip install poetry==${POETRY_VERSION} && \
    poetry self add "poetry-dynamic-versioning[plugin]@>=1.0.0,<2.2.0"

# Verify installation
RUN echo "Installed Python version: $(cat /home/hived_admin/.python-version-full)" && \
    python --version && \
    pip --version && \
    poetry --version

# Set working directory for builds
WORKDIR /home/hived_admin/build

CMD ["/bin/bash"]
